---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { categoryUrl, publishedPosts } from '../lib/posts';

const posts = publishedPosts(await getCollection('posts'));
const [latest, ...more] = posts;
const topics = [
  ['Frameworks', '{ }', 'Choosing tools by the constraints they create.'],
  ['Software Design', '◇', 'Making trade-offs visible before they become incidents.'],
  ['AI', '✦', 'Turning promising demos into dependable systems.'],
  ['Career', '↗', 'Navigating growth with craft, context, and judgment.']
];
---

<BaseLayout title="Systems & Signals · Notes by Varad" description="Varad's notes on software frameworks, system design, practical AI, careers, and lessons from the field.">
  <section class="grid-texture border-b" style="border-color:var(--line)">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-[.2em] accent">Systems &amp; Signals · Notes by Varad</p>
        <h1 class="display-font max-w-3xl text-5xl leading-[1.02] sm:text-7xl">Technology gets better when we make the thinking visible.</h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 muted">I write about the decisions behind software: choosing frameworks, designing systems, applying AI with care, and finding a career path that keeps you learning. These are working notes for people who build, operate, and improve technology.</p>
        <p class="mt-4 max-w-2xl leading-7 muted">Bring your own context. Read an idea, test it against your work, and join the conversation.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`${import.meta.env.BASE_URL}blog/`} class="rounded-full bg-[var(--accent)] px-6 py-3 text-sm font-semibold text-white">Read the latest</a>
          <a href="https://www.linkedin.com/in/varad-a-g-3" class="rounded-full border px-6 py-3 text-sm font-semibold surface" rel="me">Connect with me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md" aria-hidden="true">
        <div class="absolute -inset-6 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>
        <div class="surface relative rounded-3xl border p-5 shadow-xl">
          <div class="mb-6 flex gap-2"><span class="size-2 rounded-full bg-[#de786f]"></span><span class="size-2 rounded-full bg-[#ddb662]"></span><span class="size-2 rounded-full bg-[#69ae91]"></span></div>
          <div class="grid gap-4">
            <div class="rounded-2xl accent-bg p-5"><span class="text-xs font-semibold uppercase tracking-[.18em] accent">A useful question</span><p class="display-font mt-2 text-2xl">What are we really optimizing for?</p></div>
            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 text-center text-xs font-semibold muted"><div class="rounded-xl border p-4">Context</div><span>→</span><div class="rounded-xl border p-4">Trade-offs</div></div>
            <div class="rounded-2xl border p-5"><div class="h-2 w-2/3 rounded bg-[var(--line)]"></div><div class="mt-3 h-2 rounded bg-[var(--line)]"></div><div class="mt-3 h-2 w-4/5 rounded bg-[var(--line)]"></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {latest && <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8"><div class="mb-8"><p class="text-xs font-semibold uppercase tracking-[.18em] accent">A place to begin</p><h2 class="display-font mt-2 text-4xl">Start with a recent note</h2><p class="mt-3 max-w-2xl leading-7 muted">Each article is an invitation to compare experiences. If something resonates—or you see it differently—I would like to hear what your context reveals.</p></div><PostCard post={latest} featured />{more.length>0 && <div class="mt-7 grid gap-7 md:grid-cols-2">{more.slice(0,2).map(post=><PostCard post={post}/>)}</div>}</section>}

  <section class="border-y accent-bg" style="border-color:var(--line)"><div class="mx-auto max-w-6xl px-5 py-20 sm:px-8"><p class="text-xs font-semibold uppercase tracking-[.18em] accent">Follow a question</p><h2 class="display-font mt-2 text-4xl">Find your thread</h2><p class="mt-3 max-w-2xl leading-7 muted">The strongest technology conversations cross boundaries. A framework decision becomes a design decision; an AI feature becomes a product and career question.</p><div class="mt-8 grid gap-px overflow-hidden rounded-2xl border bg-[var(--line)] sm:grid-cols-2 lg:grid-cols-4">{topics.map(([name,mark,note])=><a href={categoryUrl(name)} class="surface group p-6"><span class="text-2xl accent" aria-hidden="true">{mark}</span><h3 class="display-font mt-8 text-xl group-hover:text-[var(--accent)]">{name}</h3><p class="mt-2 text-sm leading-6 muted">{note}</p></a>)}</div></div></section>

  <section class="mx-auto max-w-4xl px-5 py-20 text-center sm:px-8 sm:py-24"><p class="text-xs font-semibold uppercase tracking-[.18em] accent">Keep the loop open</p><h2 class="display-font mx-auto mt-3 max-w-2xl text-4xl sm:text-5xl">A blog is more useful when it becomes a conversation.</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 muted">Read what is useful, challenge what is incomplete, and share the lessons your work has taught you. You can connect with me on LinkedIn or start with any article in the archive.</p><div class="mt-8 flex justify-center gap-3"><a href="https://www.linkedin.com/in/varad-a-g-3" class="rounded-full bg-[var(--accent)] px-6 py-3 text-sm font-semibold text-white" rel="me">Say hello on LinkedIn <span aria-hidden="true">↗</span></a><a href={`${import.meta.env.BASE_URL}blog/`} class="rounded-full border px-6 py-3 text-sm font-semibold surface">Explore the archive</a></div></section>
</BaseLayout>
