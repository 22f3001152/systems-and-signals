---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('learn')).filter((entry) => !entry.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · Learn · Systems & Signals`} description={entry.data.summary}>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    <a href={`${import.meta.env.BASE_URL}learn/`} class="text-sm accent hover:underline">← All weekly learning</a>
    <p class="mt-10 text-xs font-semibold uppercase tracking-[.18em] accent">{entry.data.week}</p>
    <h1 class="display-font mt-3 text-5xl leading-tight sm:text-6xl">{entry.data.title}</h1>
    <p class="mt-5 text-lg leading-8 muted">{entry.data.summary}</p>
    <div class="mt-7 flex flex-wrap gap-2">{entry.data.topics.map((topic) => <span class="rounded-full border px-3 py-1 text-xs muted" style="border-color:var(--line)">{topic}</span>)}</div>
    <div class="prose-blog mt-12"><Content /></div>
  </article>
</BaseLayout>
