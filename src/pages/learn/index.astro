---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('learn'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Learn · Systems & Signals" description="A weekly learning log by Varad: ideas explored, lessons collected, and experiments to try next.">
  <header class="mx-auto max-w-6xl px-5 pb-12 pt-16 sm:px-8 sm:pt-24">
    <p class="text-xs font-semibold uppercase tracking-[.18em] accent">The weekly learning log</p>
    <h1 class="display-font mt-3 max-w-3xl text-5xl sm:text-6xl">Learn in public, one week at a time.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 muted">A running record of the concepts I explored, the ideas that changed my view, and the experiments I want to carry into the next week.</p>
  </header>

  <section class="mx-auto max-w-4xl px-5 sm:px-8">
    <div class="relative border-l pl-7 sm:pl-10" style="border-color:var(--line)">
      {entries.map((entry) => (
        <article class="relative mb-10 last:mb-0">
          <span class="absolute -left-[2.15rem] top-1.5 size-3 rounded-full border-2 border-[var(--accent)] bg-[var(--paper)] sm:-left-[2.65rem]" aria-hidden="true"></span>
          <p class="text-xs font-semibold uppercase tracking-[.16em] accent">{entry.data.week}</p>
          <h2 class="display-font mt-2 text-3xl"><a href={`${import.meta.env.BASE_URL}learn/${entry.data.slug}/`} class="hover:underline">{entry.data.title}</a></h2>
          <p class="mt-3 leading-7 muted">{entry.data.summary}</p>
          <div class="mt-4 flex flex-wrap gap-2">{entry.data.topics.map((topic) => <span class="rounded-full border px-3 py-1 text-xs muted" style="border-color:var(--line)">{topic}</span>)}</div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
