---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
import type { Post } from '../lib/posts';
import { categoryUrl, formatDate, readingMinutes } from '../lib/posts';
interface Props { post: Post; }
const { post } = Astro.props;
---
<BaseLayout title={`${post.data.title} · Systems & Signals`} description={post.data.description} article>
  <article><header class="mx-auto max-w-4xl px-5 pb-10 pt-16 text-center sm:px-8 sm:pt-24">
    <a href={categoryUrl(post.data.category)} class="text-xs font-semibold uppercase tracking-[.18em] accent">{post.data.category}</a><h1 class="display-font mx-auto mt-5 max-w-3xl text-4xl leading-[1.08] sm:text-6xl">{post.data.title}</h1><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 muted">{post.data.description}</p><div class="mt-6 flex justify-center gap-3 text-sm muted"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span>·</span><span>{readingMinutes(post.body)} min read</span></div>
  </header><div class="mx-auto max-w-5xl px-5 sm:px-8"><Image src={post.data.cover} alt={post.data.coverAlt} widths={[720,1100,1500]} sizes="(min-width:1024px) 960px, 100vw" class="max-h-[34rem] w-full rounded-2xl border object-cover surface" /></div><div class="prose-blog mx-auto max-w-3xl px-5 pt-12 sm:px-8 sm:pt-16"><slot /></div><Giscus /></article>
</BaseLayout>
<script>
  import mermaid from 'mermaid';

  async function draw() {
    document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"], pre > code.language-mermaid').forEach((source) => {
      const pre = source.matches('pre') ? source : source.parentElement;
      if (!pre) return;
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.dataset.source = source.textContent || '';
      div.textContent = div.dataset.source;
      pre.replaceWith(div);
    });

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'neutral'
    });

    const nodes = [...document.querySelectorAll<HTMLElement>('[data-source]')];
    nodes.forEach((node) => {
      node.removeAttribute('data-processed');
      node.textContent = node.dataset.source || '';
    });
    if (nodes.length) await mermaid.run({ nodes });
  }
  void draw();window.addEventListener('theme-change',()=>void draw());
</script>
