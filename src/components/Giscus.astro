---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = Boolean(repo && repoId && categoryId);
---

{enabled && (
  <section class="mx-auto mt-20 max-w-3xl border-t px-5 pt-12 sm:px-8" style="border-color:var(--line)" aria-labelledby="comments-heading">
    <p class="text-xs font-semibold uppercase tracking-[.18em] accent">Continue the conversation</p>
    <h2 id="comments-heading" class="display-font mt-2 text-3xl">What does this look like in your context?</h2>
    <p class="mt-3 leading-7 muted">Share an example, a different trade-off, or a question. Thoughtful disagreement makes these notes more useful.</p>
    <div class="giscus-shell mt-8">
      <script
        src="https://giscus.app/client.js"
        is:inline
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </section>
)}

{enabled && <script>
  const updateGiscusTheme = () => {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light' } } }, 'https://giscus.app');
  };
  window.addEventListener('theme-change', updateGiscusTheme);
  window.addEventListener('load', () => window.setTimeout(updateGiscusTheme, 500));
</script>}
